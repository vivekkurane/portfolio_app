{
  "name": "vivekanand-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Animated full-stack portfolio: React + Vite frontend, Express contact API",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "express": "^4.22.3",
    "nodemailer": "^10.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
